rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAdmin() {
      return isSignedIn()
        && exists(userDocPath(myUid()))
        && get(userDocPath(myUid())).data.role == 'admin';
    }

    // users: private profile data. A customer may only read/edit their own
    // profile; admins may read all. Nobody may escalate their own role.
    match /users/{uid} {
      allow get: if isSignedIn() && (myUid() == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && myUid() == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin()
        || (isSignedIn()
          && myUid() == uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // products: the catalog is the only publicly readable collection.
    // All writes go through the trusted API (Admin SDK bypasses these rules).
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // orders: private. Reads are limited to the owning customer and admins.
    // Clients may NOT create orders — order prices/totals must be computed by
    // the trusted backend (POST /api/orders), which uses the Admin SDK and is
    // not affected by this rule. Only admins (or the backend) may change
    // orderStatus / paymentStatus / gcashDetails / paymentDecision /
    // paymentAudit, so customers cannot mark payments paid, edit submitted
    // GCash details after the fact, or tamper with the audit trail — all
    // payment state changes go through the trusted backend endpoints
    // (POST /api/orders/:id/gcash-details, POST /api/admin/orders/:id/payment).
    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.customerId == myUid() || isAdmin());
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // payments: private. Reserved for future backend-managed payment records
    // (manual GCash verification lives on the order document itself; there is
    // no payment gateway, webhook, or automated processing). Only the backend
    // creates payment records and only admins may change a status.
    match /payments/{paymentId} {
      allow read: if isSignedIn()
        && (resource.data.customerId == myUid() || isAdmin());
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // contactMessages: customer "Contact Us" submissions. Only the trusted
    // backend writes them (POST /api/contact-messages via the Admin SDK,
    // which bypasses these rules). Clients may neither read nor write —
    // customers cannot view their own or other customers' messages, and
    // nobody can tamper with stored messages. This block is purely
    // restrictive documentation of that intent (an unmatched collection is
    // already denied by default).
    match /contactMessages/{messageId} {
      allow read, write: if false;
    }
  }
}
