# BistroBuddies backend — environment variables.
# Copy to `.env` for local development and fill in values.
# NEVER commit a real `.env` file or service-account JSON to Git.

# Port the local development server listens on (default 3001).
PORT=3001

# Delivery fee in PHP applied to every order (0 = free delivery).
# Must stay consistent with the frontends' display value.
DELIVERY_FEE=0

# Firebase project used by BistroBuddies (existing project — do not change
# unless the Firebase project itself changes).
FIREBASE_PROJECT_ID=bistrobuddies-4f179

# Path to a service-account JSON file (firebase-admin credentials).
# Keep this file OUTSIDE the repository or at least git-ignored.
# Alternative: set FIREBASE_SERVICE_ACCOUNT instead.
GOOGLE_APPLICATION_CREDENTIALS=

# Alternative to GOOGLE_APPLICATION_CREDENTIALS: the full service-account
# JSON as a single-line string. Leave empty when using the file-based option.
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated list of allowed browser origins for CORS.
# When left unset it defaults to local dev + Capacitor webviews
# (localhost:4200/8100/8101, capacitor://localhost, https://localhost).
# MUST be set to the real frontend origin(s) in production (e.g. Render):
# the built-in default does not include any production domain.
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100,capacitor://localhost,https://localhost

# Set to 1 when running behind a reverse proxy (Render, Vercel, etc.) so that
# rate limiting sees the real client IP from X-Forwarded-For.
TRUST_PROXY=0

# --- Image uploads (Cloudinary, see docs/API_CONTRACT.md) ----------------------

# Legacy local directory for historical `GET /uploads/<file>` reads only.
# New uploads go to Cloudinary and never touch local disk (local disk is not
# durable on hosts like Render). Kept so old local URLs remain readable.
UPLOAD_DIR=uploads

# Legacy base URL for old local files. New Cloudinary uploads return an
# absolute HTTPS `secure_url` and do not use this value.
# Default when unset: http://localhost:<PORT>
API_BASE_URL=http://localhost:3001

# Maximum accepted upload size in bytes (default 5242880 = 5 MB).
UPLOAD_MAX_BYTES=5242880

# Cloudinary image storage (server-side only — never expose these to a
# frontend or commit real values). Required for POST /api/admin/uploads and
# POST /api/profile/photo in every environment, including local development:
# when any of these is missing the upload endpoints return
# `503 server_not_configured` instead of pretending the upload succeeded.
# Find them in the Cloudinary dashboard (https://cloudinary.com/console):
# - CLOUDINARY_CLOUD_NAME: product environment cloud name (public identifier).
# - CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET: server-side credentials.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret